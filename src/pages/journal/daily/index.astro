---
export const prerender = true;

const notebooks = [
  {
    id: 'kalokagathia',
    title: 'Калокагатия и дурдом бытия',
    date: '2026',
    cover: '/Umoral/notebooks/kalokagathia/cover.jpg'
  }
];
---

<html>
  <head>
    <title>Блокноты | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        background: #1a1a1a;
        min-height: 100vh;
        color: #fff;
        padding: 2rem 3rem; /* Отступы от краёв */
      }

      .nav {
        margin-bottom: 2rem; /* Отступ от кнопки до заголовка */
      }
      .nav a {
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        font-size: 0.9rem;
        display: inline-block;
      }
      .nav a:hover { color: #fff; }

      h1 {
        font-size: 2rem;
        font-weight: 300;
        margin-bottom: 2rem;
        color: rgba(255,255,255,0.8);
      }

      .notebooks-container {
        display: flex;
        flex-wrap: wrap;
        gap: 3rem;
      }

      .notebook-item {
        text-decoration: none;
        color: #fff;
        width: 200px;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: transform 0.2s;
      }

      .notebook-item:hover {
        transform: translateY(-5px);
      }

      .notebook-cover {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        border-radius: 4px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
      }

      .notebook-info h2 {
        font-size: 1.1rem;
        font-weight: 600;
        line-height: 1.3;
      }

      .notebook-info p {
        font-size: 0.85rem;
        color: rgba(255,255,255,0.5);
        margin-top: 0.3rem;
      }

      @media (max-width: 600px) {
        body { padding: 1.5rem; }
        .notebooks-container { gap: 2rem; }
        .notebook-item { width: 150px; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
    </nav>

    <h1>Блокноты</h1>

    <div class="notebooks-container">
      {notebooks.map(notebook => (
        <a href={`/Umoral/journal/daily/${notebook.id}/`} class="notebook-item">
          <img src={notebook.cover} alt={notebook.title} class="notebook-cover" />
          <div class="notebook-info">
            <h2>{notebook.title}</h2>
            <p>{notebook.date}</p>
          </div>
        </a>
      ))}
    </div>
  </body>
</html>