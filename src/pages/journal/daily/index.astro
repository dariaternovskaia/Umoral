---
export const prerender = true;

// Обычные блокноты — новые добавляй сюда,
// они всегда будут стоять ДО «Голдобины»
const notebooks = [
  {
    id: 'kalokagathia',
    title: 'Калокагатия и дурдом бытия',
    date: '2026',
    cover: '/Umoral/notebooks/kalokagathia/cover.jpg'
  }
];

// «Голдобина» — сборная солянка потерянных страниц,
// поэтому жёстко закреплена последней в списке
const alwaysLast = [
  {
    id: 'goldobina',
    title: 'Голдобина (потерянные страницы)',
    date: 'разные годы',
    cover: '/Umoral/notebooks/goldobina/cover.jpg'
  }
];

const allNotebooks = [...notebooks, ...alwaysLast];
---

<html>
  <head>
    <title>Блокноты | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background: #1a1a1a;
        min-height: 100vh;
        color: #ffffff;
      }

      .wrapper {
        padding: 40px 30px 30px 80px;
        width: 100%;
        min-height: 100vh;
      }

      .nav {
        margin-bottom: 30px;
        display: block;
      }
      .nav a {
        color: #999999;
        text-decoration: none;
        font-size: 14px;
      }
      .nav a:hover { color: #ffffff; }

      h1 {
        font-size: 32px;
        font-weight: 300;
        margin-bottom: 30px;
        color: #cccccc;
      }

      .notebooks-container {
        display: flex;
        flex-wrap: wrap;
        gap: 40px;
      }

      .notebook-item {
        text-decoration: none;
        color: #ffffff;
        width: 200px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: transform 0.2s;
      }

      .notebook-item:hover { transform: translateY(-5px); }

      .notebook-cover {
        width: 100%;
        aspect-ratio: 3/4;
        object-fit: cover;
        border-radius: 4px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.5);
      }

      .notebook-info h2 {
        font-size: 16px;
        font-weight: 600;
        line-height: 1.3;
      }

      .notebook-info p {
        font-size: 13px;
        color: #888888;
      }
    </style>
  </head>
  <body>
    <div class="wrapper">
      <nav class="nav">
        <a href="/Umoral/">← На главную</a>
      </nav>

      <h1>Блокноты</h1>

      <div class="notebooks-container">
        {allNotebooks.map(notebook => (
          <a href={`/Umoral/journal/daily/${notebook.id}/`} class="notebook-item">
            <img src={notebook.cover} alt={notebook.title} class="notebook-cover" />
            <div class="notebook-info">
              <h2>{notebook.title}</h2>
              <p>{notebook.date}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </body>
</html>