---
export const prerender = true;

const title = "Калокагатия и дурдом бытия";
const totalPages = 28; // Жёстко задаем количество страниц
const notebookFolder = "kalokagathia";
---

<html>
  <head>
    <title>{title} | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        background: #1a1a1a;
        min-height: 100vh;
        color: #fff;
        display: flex;
        flex-direction: column;
      }

      .nav {
        padding: 2rem 3rem; /* Те же отступы, что и на главной */
      }
      .nav a {
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        font-size: 0.9rem;
        border: 1px solid rgba(255,255,255,0.3);
        padding: 0.5rem 1rem;
        border-radius: 4px;
      }
      .nav a:hover { color: #fff; border-color: #fff; }

      .header {
        text-align: center;
        padding: 1rem 2rem 2rem;
      }

      .header h1 {
        font-size: 2rem;
        font-weight: 300;
        color: #ddd;
      }

      .viewer-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 2rem 2rem;
      }

      .image-wrapper {
        width: 100%;
        max-width: 800px; /* Максимальная ширина фото */
        background: #fff;
        box-shadow: 0 0 50px rgba(0,0,0,0.8);
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
      }

      .page-image {
        width: 100%;
        height: auto;
        display: block;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      
      .page-image.loaded {
        opacity: 1;
      }

      .loader {
        position: absolute;
        color: #999;
        font-size: 0.9rem;
      }

      .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 2rem;
        margin-top: 2rem;
        padding-bottom: 2rem;
      }

      .btn {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        padding: 0.8rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 1rem;
        transition: all 0.2s;
        font-family: 'Georgia', serif;
      }

      .btn:hover:not(:disabled) {
        background: rgba(255,255,255,0.2);
        border-color: #fff;
      }

      .btn:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      .page-counter {
        font-size: 1.1rem;
        color: #aaa;
        min-width: 80px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/journal/daily/">← К блокнотам</a>
    </nav>

    <div class="header">
      <h1>{title}</h1>
    </div>

    <div class="viewer-area">
      <div class="image-wrapper">
        <span class="loader">Загрузка страницы...</span>
        <img id="notebookImg" class="page-image" src="" alt="Страница блокнота" />
      </div>

      <div class="controls">
        <button class="btn" id="prevBtn" onclick="changePage(-1)">← Пред.</button>
        <span class="page-counter" id="counter">1 / {totalPages}</span>
        <button class="btn" id="nextBtn" onclick="changePage(1)">След. →</button>
      </div>
    </div>

    <script>
      // Настройки
      const config = {
        startPage: 1,
        totalPages: {totalPages},
        // Путь к папке с картинками (начинается со слэша!)
        baseUrl: '/Umoral/notebooks/kalokagathia/' 
      };

      let currentPage = 1;
      const imgElement = document.getElementById('notebookImg');
      const prevBtn = document.getElementById('prevBtn');
      const nextBtn = document.getElementById('nextBtn');
      const counterElement = document.getElementById('counter');

      // Функция для добавления нулей (001, 010...)
      function padNum(num) {
        return String(num).padStart(3, '0');
      }

      // Функция обновления картинки
      function updateViewer() {
        const fileName = `page-${padNum(currentPage)}.jpg`;
        const fullUrl = config.baseUrl + fileName;
        
        // Показываем лоадер, скрываем старую картинку
        imgElement.classList.remove('loaded');
        imgElement.style.display = 'none';
        document.querySelector('.loader').style.display = 'block';

        // Создаем новый объект Image для предзагрузки
        const tempImg = new Image();
        tempImg.onload = function() {
          imgElement.src = fullUrl;
          imgElement.style.display = 'block';
          imgElement.classList.add('loaded');
          document.querySelector('.loader').style.display = 'none';
        };
        tempImg.onerror = function() {
           document.querySelector('.loader').textContent = "Ошибка загрузки";
        };
        tempImg.src = fullUrl;

        // Обновляем текст
        counterElement.textContent = `${currentPage} / ${config.totalPages}`;

        // Блокируем кнопки
        prevBtn.disabled = (currentPage === 1);
        nextBtn.disabled = (currentPage === config.totalPages);
      }

      // Переключение страниц
      window.changePage = function(delta) {
        const newPage = currentPage + delta;
        if (newPage >= 1 && newPage <= config.totalPages) {
          currentPage = newPage;
          updateViewer();
        }
      };

      // Клавиатура
      document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') changePage(-1);
        if (e.key === 'ArrowRight') changePage(1);
      });

      // Запуск
      updateViewer();
    </script>
  </body>
</html>