---
export const prerender = true;

const title = "Калокагатия и дурдом бытия";
const totalPages = 28;
---

<html>
  <head>
    <title>{title} | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: 'Georgia', serif;
        background: #1a1a1a;
        min-height: 100vh;
        color: #fff;
        display: flex;
        flex-direction: column;
      }
      .nav { padding: 2rem 3rem; }
      .nav a {
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.3);
        padding: 0.5rem 1rem;
        border-radius: 4px;
      }
      .header { text-align: center; padding: 1rem 2rem 2rem; }
      .header h1 { font-size: 2rem; font-weight: 300; color: #ddd; }
      
      .viewer-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 0 2rem 2rem;
      }

      .image-wrapper {
        width: 100%;
        max-width: 800px;
        background: #fff;
        box-shadow: 0 0 50px rgba(0,0,0,0.8);
        min-height: 400px;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
      }

      .page-image {
        width: 100%;
        height: auto;
        display: block;
      }

      .debug-info {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background: rgba(0,0,0,0.8);
        color: #0f0;
        padding: 10px;
        font-family: monospace;
        font-size: 12px;
        word-break: break-all;
      }

      .controls {
        display: flex;
        gap: 2rem;
        margin-top: 2rem;
        align-items: center;
      }
      .btn {
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.3);
        color: #fff;
        padding: 0.8rem 1.5rem;
        border-radius: 4px;
        cursor: pointer;
      }
      .btn:disabled { opacity: 0.3; cursor: not-allowed; }
      .page-counter { font-size: 1.1rem; color: #aaa; }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/journal/daily/">← К блокнотам</a>
    </nav>

    <div class="header">
      <h1>{title}</h1>
    </div>

    <div class="viewer-area">
      <div class="image-wrapper">
        <img id="notebookImg" class="page-image" src="" alt="Page" />
        <div class="debug-info" id="debugInfo">Загрузка...</div>
      </div>

      <div class="controls">
        <button class="btn" id="prevBtn" onclick="changePage(-1)">← Пред.</button>
        <span class="page-counter" id="counter">1 / {totalPages}</span>
        <button class="btn" id="nextBtn" onclick="changePage(1)">След. →</button>
      </div>
    </div>

    <script>
      const totalPages = {totalPages};
      let currentPage = 1;
      
      // ВАЖНО: Пробуем разные варианты путей
      const baseUrl = '/Umoral/notebooks/kalokagathia/';
      
      const imgElement = document.getElementById('notebookImg');
      const debugElement = document.getElementById('debugInfo');

      function padNum(num) {
        return String(num).padStart(3, '0');
      }

      function updateViewer() {
        const fileName = `page-${padNum(currentPage)}.jpg`;
        const fullUrl = baseUrl + fileName;
        
        // Показываем отладку
        debugElement.innerHTML = `Trying: ${fullUrl}<br>Status: Loading...`;
        debugElement.style.color = '#ff0';

        // Пробуем загрузить
        const testImg = new Image();
        testImg.onload = function() {
          imgElement.src = fullUrl;
          debugElement.innerHTML = `OK: ${fullUrl}`;
          debugElement.style.color = '#0f0';
        };
        testImg.onerror = function() {
          debugElement.innerHTML = `ERROR 404: ${fullUrl}<br>Check if file exists!`;
          debugElement.style.color = '#f00';
          // Попробуем без /Umoral
          const altUrl = `/notebooks/kalokagathia/${fileName}`;
          debugElement.innerHTML += `<br>Trying alt: ${altUrl}`;
          
          const testImg2 = new Image();
          testImg2.onload = function() {
             imgElement.src = altUrl;
             debugElement.innerHTML += `<br>ALT OK!`;
          }
          testImg2.src = altUrl;
        };
        
        testImg.src = fullUrl;

        document.getElementById('counter').textContent = `${currentPage} / ${totalPages}`;
        document.getElementById('prevBtn').disabled = (currentPage === 1);
        document.getElementById('nextBtn').disabled = (currentPage === totalPages);
      }

      window.changePage = function(delta) {
        const newPage = currentPage + delta;
        if (newPage >= 1 && newPage <= totalPages) {
          currentPage = newPage;
          updateViewer();
        }
      };

      updateViewer();
    </script>
  </body>
</html>