<html>
  <head>
    <title>Umoral</title>
    <meta charset="UTF-8">
    <style>
      body { 
        font-family: sans-serif; 
        max-width: 800px; 
        margin: 0 auto; 
        padding: 2rem;
        background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.25)), url('/Umoral/bg-main.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
      }
      
      /* Стили для боксов — как на странице со стихами */
      .section { 
        margin: 2rem 0; 
        padding: 2rem 1rem;
        background: #fff;
        border: 2.5px solid #333;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: all 0.2s;
      }
      
      .section:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        border-color: #000;
      }
      
      h2 { 
        margin-top: 0;
        margin-bottom: 1rem;
        font-size: 1.3rem;
        font-weight: 700;
        color: #222;
        text-align: center;
      }
      
      a { 
        color: #333; 
        text-decoration: none;
        font-weight: 600;
      }
      
      a:hover { 
        color: #000;
        text-decoration: underline; 
      }
      
      ul {
        margin: 0;
        padding-left: 1.5rem;
      }
      
      li {
        margin: 0.5rem 0;
        color: #444;
      }
    </style>
  </head>
