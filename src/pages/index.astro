---

<html>
  <head>
    <title>Umoral</title>
    <meta charset="UTF-8">
    <style>
      body { 
        font-family: sans-serif; 
        max-width: 1200px;
        margin: 0 auto; 
        /* Уменьшили отступ сверху до 6rem, чтобы не перекрывать фигуры */
        padding: 6rem 2rem 2rem 2rem; 
        background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('/Umoral/bg-main.jpg');
        background-size: cover;
        /* Сместили фокус чуть ниже центра (60%), чтобы фигуры были в кадре */
        background-position: center 60%; 
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
      }
      
      /* Контейнер для боксов в ряд */
      .boxes-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* 3 колонки */
        gap: 2rem;
        max-width: 1000px;
        margin: 0 auto;
      }
      
      /* Стили для боксов (как на странице стихов) */
      .section { 
        padding: 2rem 1.5rem;
        background: #fff;
        border: 2.5px solid #333;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: all 0.2s;
        min-height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }
      
      .section:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        border-color: #000;
      }
      
      h2 { 
        margin: 0 0 1rem 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #222;
        text-align: center;
      }
      
      a { 
        color: #333; 
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: block;
        margin: 0.4rem 0;
      }
      
      a:hover { 
        color: #000;
        text-decoration: underline; 
      }
      
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      
      li {
        margin: 0;
        color: #444;
      }
      
      /* Адаптивность */
      @media (max-width: 900px) {
        .boxes-container {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      
      @media (max-width: 650px) {
        .boxes-container {
          grid-template-columns: 1fr;
        }
        body {
          padding-top: 4rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="boxes-container">
      <div class="section">
        <h2>Философия</h2>
        <ul>
          <li><a href="content/philosophy/essays/">Эссе и видео-эссе</a></li>
          <li><a href="content/philosophy/comments/">Комментарии</a></li>
          <li><a href="content/philosophy/thoughts/">Мысли</a></li>
        </ul>
      </div>

      <div class="section">
        <h2>Творчество</h2>
        <ul>
          <li><a href="content/creativity/poems/">Стихи</a></li>
          <li><a href="content/creativity/prose/">Проза</a></li>
          <li><a href="content/creativity/drawings/">Рисунки</a></li>
          <li><a href="content/creativity/notes/">Заметки</a></li>
        </ul>
      </div>

      <div class="section">
        <h2>Журнал</h2>
        <ul>
          <li><a href="content/journal/diary/">Дневник</a></li>
          <li><a href="content/journal/daily/">Ежедневник</a></li>
        </ul>
      </div>
    </div>
  </body>
</html>