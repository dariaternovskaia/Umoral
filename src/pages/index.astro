---

<html>
  <head>
    <title>Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        background: linear-gradient(rgba(0,0,0,0.0), rgba(0,0,0,0.0)), url('/Umoral/bg-main.jpg');
        background-size: cover;
        /* 15% сдвигает картинку так, чтобы верхняя часть (головы) была видна */
        background-position: center 50%; 
        background-attachment: fixed;
        min-height: 100vh;
        padding: 5rem 2rem 3rem;
        color: #fff;
      }
      
      .boxes-container {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
        max-width: 1000px;
        /* Карточки остаются на прежнем месте, в нижней трети экрана */
        margin: 35rem auto 0 auto; 
      }
      
      .section { 
        padding: 2rem 1.5rem;
        background: #fff;
        border: 2.5px solid #333;
        border-radius: 16px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        transition: all 0.2s;
        min-height: 180px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }
      
      .section:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
        border-color: #000;
      }
      
      h2 { 
        margin: 0 0 1rem 0;
        font-size: 1.4rem;
        font-weight: 700;
        color: #222;
        text-align: center;
      }
      
      a { 
        color: #333; 
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: block;
        margin: 0.4rem 0;
      }
      
      a:hover { 
        color: #000;
        text-decoration: underline; 
      }
      
      ul {
        margin: 0;
        padding: 0;
        list-style: none;
      }
      
      li {
        margin: 0;
        color: #444;
      }
      
      @media (max-width: 900px) {
        .boxes-container {
          grid-template-columns: repeat(2, 1fr);
          margin-top: 8rem;
        }
      }
      
      @media (max-width: 650px) {
        .boxes-container {
          grid-template-columns: 1fr;
          margin-top: 6rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="boxes-container">
      <div class="section">
        <h2>Философия</h2>
        <ul>
          <li><a href="content/philosophy/essays/">Эссе и видео-эссе</a></li>
          <li><a href="content/philosophy/comments/">Комментарии</a></li>
          <li><a href="content/philosophy/thoughts/">Мысли</a></li>
        </ul>
      </div>

      <div class="section">
        <h2>Творчество</h2>
        <ul>
          <li><a href="content/creativity/poems/">Стихи</a></li>
          <li><a href="content/creativity/prose/">Проза</a></li>
          <li><a href="content/creativity/drawings/">Arduino</a></li>
          <li><a href="content/creativity/notes/">Заметки</a></li>
        </ul>
      </div>

      <div class="section">
        <h2>Журнал</h2>
        <ul>
          <li><a href="/Umoral/journal/diary/">Дневник</a></li>
          <li><a href="/Umoral/journal/daily/">Блокноты</a></li>
        </ul>
      </div>
    </div>
  </body>
</html>