---
import { getCollection } from 'astro:content';

let notes = await getCollection('content', ({ id }) => id.startsWith('creativity/notes/'));
notes = notes.filter(note => !note.data.draft);
notes.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>Заметки</title>
    <style>
      body { 
        font-family: sans-serif; 
        max-width: 600px; 
        margin: 0 auto; 
        padding: 2rem;
        color: #fff; /* Белый текст */
        /* Затемнённый фон (сильнее чем раньше) */
        background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('/Umoral/bg-books.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
      }
      h1 { 
        font-size: 1.4rem;
        margin-bottom: 1.5rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #444;
        color: #fff;
      }
      .note { 
        padding: 0.5rem 0;
        border-bottom: 1px dashed #444;
        line-height: 1.3;
      }
      /* Жёстко убираем отступы у всех элементов внутри заметки */
      .note p, .note div, .note span {
        margin: 0 !important;
        padding: 0 !important;
        display: inline;
      }
      .note-text {
        font-size: 0.95rem;
        color: #fff; /* Белый текст заметки */
      }
      .note-date {
        font-size: 0.75rem;
        color: #aaa; /* Светло-серая дата */
        margin-left: 0.6rem;
        opacity: 0 !important;
        transition: opacity 0.2s ease;
        pointer-events: none;
        display: inline-block;
        vertical-align: middle;
      }
      .note:hover .note-date {
        opacity: 1 !important;
      }
      .back { 
        display: inline-block;
        margin-bottom: 2rem; /* Кнопка сверху */
        color: #ccc;
        font-size: 0.85rem;
        text-decoration: none;
      }
      .back:hover { color: #fff; }
    </style>
  </head>
  <body>
    <a href="../../../" class="back">← На главную</a>
    
    <h1>Заметки</h1>
    
    <div>
      {notes.map((note) => (
        <div class="note">
          <span class="note-text">{note.body.trim()}</span>
          <span class="note-date">{note.data.date.toLocaleDateString('ru-RU')}</span>
        </div>
      ))}
    </div>
  </body>
</html>