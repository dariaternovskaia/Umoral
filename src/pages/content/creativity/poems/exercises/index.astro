---
import { getCollection } from 'astro:content';

const exercises = await getCollection('content', ({ id }) => 
  id.startsWith('creativity/poems/exercises/')
);

function formatDate(value) {
  if (!value) return '';
  if (value instanceof Date) {
    return value.toLocaleDateString('ru-RU');
  }
  return String(value);
}
---

<html>
  <head>
    <title>Упражнения | Umoral</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400&display=swap');
      
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Montserrat', sans-serif;
        background-color: #8B3A5A; /* Классический бордовый, не слишком тёмный */
        overflow: hidden;
        color: #fff;
        height: 100vh;
        width: 100vw;
        user-select: none;
      }

      #canvas {
        width: 100%;
        height: 100%;
        cursor: grab;
        position: relative;
        touch-action: none;
      }
      #canvas:active { cursor: grabbing; }

      #wall {
        position: absolute;
        top: 0; left: 0;
        transform-origin: 0 0;
        will-change: transform;
      }

      .poem-text {
        position: absolute;
        color: #FFFFFF;
        font-size: 1.05rem;
        line-height: 1.8;
        font-weight: 200;
        letter-spacing: 0.8px;
        white-space: pre;
        width: max-content;
        text-indent: 0;
      }

      .poem-date {
        display: block;
        margin-top: 0.6rem;
        font-size: 0.85rem;
        color: rgba(255,255,255,0.75);
        font-style: normal;
        font-weight: 300;
        text-align: right;
        text-indent: 0;
        letter-spacing: 0.5px;
      }

      .nav {
        position: fixed;
        top: 20px; left: 20px;
        display: flex; gap: 0.8rem;
        z-index: 100;
      }
      .nav a {
        color: rgba(255,255,255,0.95); text-decoration: none; font-size: 0.9rem;
        padding: 0.4rem 0.9rem; border: 1px solid rgba(255,255,255,0.4); border-radius: 6px;
        background: rgba(0,0,0,0.2); backdrop-filter: blur(4px);
        transition: all 0.2s;
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
        letter-spacing: 0.5px;
      }
      .nav a:hover { background: rgba(0,0,0,0.4); border-color: #fff; }

      .hint {
        position: fixed;
        bottom: 20px; left: 50%; transform: translateX(-50%);
        background: rgba(0,0,0,0.5); color: rgba(255,255,255,0.9);
        padding: 8px 16px; border-radius: 20px; font-size: 0.85rem;
        pointer-events: none; user-select: none;
        backdrop-filter: blur(4px);
        z-index: 50;
        border: 1px solid rgba(255,255,255,0.2);
        font-family: 'Montserrat', sans-serif;
        font-weight: 300;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
    </nav>

    <div id="canvas">
      <div id="wall">
        {exercises.map(ex => (
          <div 
            class="poem-text" 
            style={`left: ${ex.data.x || 0}px; top: ${ex.data.y || 0}px;`}
          >
            {ex.body}
            {ex.data.date && <span class="poem-date">{formatDate(ex.data.date)}</span>}
          </div>
        ))}
      </div>
    </div>

    <div class="hint">✋ Тяни для перемещения · 🔄 Колёсико для масштаба</div>

    <script>
      const canvas = document.getElementById('canvas');
      const wall = document.getElementById('wall');
      
      let scale = 1;
      let pX = 0;
      let pY = 0;
      let isPanning = false;
      let startX, startY;
      let lastTouchDist = 0;

      function updateTransform() {
        wall.style.transform = `translate(${pX}px, ${pY}px) scale(${scale})`;
      }

      canvas.addEventListener('mousedown', (e) => {
        isPanning = true;
        startX = e.clientX - pX;
        startY = e.clientY - pY;
        canvas.style.cursor = 'grabbing';
      });

      window.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        pX = e.clientX - startX;
        pY = e.clientY - startY;
        updateTransform();
      });

      window.addEventListener('mouseup', () => {
        isPanning = false;
        canvas.style.cursor = 'grab';
      });

      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomSpeed = 0.1;
        const delta = e.deltaY < 0 ? zoomSpeed : -zoomSpeed;
        const newScale = Math.min(Math.max(scale + delta, 0.3), 4);
        
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;
        
        pX = mouseX - (mouseX - pX) * (newScale / scale);
        pY = mouseY - (mouseY - pY) * (newScale / scale);
        scale = newScale;
        updateTransform();
      }, { passive: false });

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isPanning = true;
          startX = e.touches[0].clientX - pX;
          startY = e.touches[0].clientY - pY;
        } else if (e.touches.length === 2) {
          isPanning = false;
          lastTouchDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
        }
      }, { passive: false });

      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        if (e.touches.length === 1 && isPanning) {
          pX = e.touches[0].clientX - startX;
          pY = e.touches[0].clientY - startY;
          updateTransform();
        } else if (e.touches.length === 2) {
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const delta = (dist - lastTouchDist) * 0.005;
          scale = Math.min(Math.max(scale + delta, 0.3), 4);
          lastTouchDist = dist;
          updateTransform();
        }
      }, { passive: false });

      canvas.addEventListener('touchend', () => {
        isPanning = false;
      });

      updateTransform();
    </script>
  </body>
</html>