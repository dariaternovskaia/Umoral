---
import { getCollection } from 'astro:content';

// Загружаем только стихи из папки exercises
const exercises = await getCollection('content', ({ id }) => 
  id.startsWith('creativity/poems/exercises/')
);
---

<html>
  <head>
    <title>Упражнения | Umoral</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        background-color: #c4a484; /* Крафтовая бумага */
        overflow: hidden;
        color: #fff;
        height: 100vh;
        width: 100vw;
        user-select: none;
      }

      #canvas {
        width: 100%;
        height: 100%;
        cursor: grab;
        position: relative;
        touch-action: none;
      }
      #canvas:active { cursor: grabbing; }

      #wall {
        position: absolute;
        top: 0; left: 0;
        transform-origin: 0 0;
        will-change: transform;
      }

      .poem-card {
        position: absolute;
        background: rgba(30, 25, 20, 0.9);
        padding: 1.5rem;
        border-radius: 8px;
        max-width: 300px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.3);
        border: 1px solid rgba(255,255,255,0.15);
        transition: box-shadow 0.2s;
      }

      .poem-card:hover {
        box-shadow: 0 8px 30px rgba(0,0,0,0.5);
        z-index: 5;
      }

      .poem-text {
        white-space: pre-wrap;
        line-height: 1.8;
        font-size: 0.95rem;
        color: #f5f5f5;
        text-align: left;
      }

      .poem-date {
        margin-top: 1rem;
        font-size: 0.75rem;
        color: #bbb;
        font-style: italic;
        text-align: right;
        opacity: 0.8;
      }

      .nav {
        position: fixed;
        top: 20px; left: 20px;
        display: flex; gap: 0.8rem;
        z-index: 100;
      }
      .nav a {
        color: rgba(255,255,255,0.9); text-decoration: none; font-size: 0.85rem;
        padding: 0.4rem 0.9rem; border: 1px solid rgba(255,255,255,0.4); border-radius: 6px;
        background: rgba(0,0,0,0.25); backdrop-filter: blur(4px);
        transition: all 0.2s;
      }
      .nav a:hover { background: rgba(0,0,0,0.45); border-color: #fff; }

      .hint {
        position: fixed;
        bottom: 20px; left: 50%; transform: translateX(-50%);
        background: rgba(0,0,0,0.4); color: rgba(255,255,255,0.85);
        padding: 8px 16px; border-radius: 20px; font-size: 0.8rem;
        pointer-events: none; user-select: none;
        backdrop-filter: blur(4px);
        z-index: 50;
      }

      @media (max-width: 600px) {
        .poem-card { max-width: 260px; padding: 1.2rem; }
        .poem-text { font-size: 0.9rem; }
        .hint { font-size: 0.75rem; padding: 6px 12px; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
    </nav>

    <div id="canvas">
      <div id="wall">
        {exercises.map(ex => (
          <article class="poem-card" style={`left: ${ex.data.x || 0}px; top: ${ex.data.y || 0}px;`}>
            <div class="poem-text">{ex.body}</div>
            {ex.data.date && <div class="poem-date">{ex.data.date}</div>}
          </article>
        ))}
      </div>
    </div>

    <div class="hint">✋ Тяни для перемещения · 🔄 Колёсико для масштаба</div>

    <script>
      const canvas = document.getElementById('canvas');
      const wall = document.getElementById('wall');
      
      let scale = 1;
      let pX = 0;
      let pY = 0;
      let isPanning = false;
      let startX, startY;
      let lastTouchDist = 0;

      function updateTransform() {
        wall.style.transform = `translate(${pX}px, ${pY}px) scale(${scale})`;
      }

      // Мышь: начало перетаскивания
      canvas.addEventListener('mousedown', (e) => {
        if (e.target.closest('.poem-card')) return;
        isPanning = true;
        startX = e.clientX - pX;
        startY = e.clientY - pY;
        canvas.style.cursor = 'grabbing';
      });

      // Мышь: перемещение
      window.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        pX = e.clientX - startX;
        pY = e.clientY - startY;
        updateTransform();
      });

      // Мышь: конец перетаскивания
      window.addEventListener('mouseup', () => {
        isPanning = false;
        canvas.style.cursor = 'grab';
      });

      // Мышь: зум колёсиком
      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomSpeed = 0.1;
        const delta = e.deltaY < 0 ? zoomSpeed : -zoomSpeed;
        const newScale = Math.min(Math.max(scale + delta, 0.3), 4);
        
        // Зум к точке курсора
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;
        
        pX = mouseX - (mouseX - pX) * (newScale / scale);
        pY = mouseY - (mouseY - pY) * (newScale / scale);
        scale = newScale;
        updateTransform();
      }, { passive: false });

      // Тач: начало
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          isPanning = true;
          startX = e.touches[0].clientX - pX;
          startY = e.touches[0].clientY - pY;
        } else if (e.touches.length === 2) {
          isPanning = false;
          lastTouchDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
        }
      }, { passive: false });

      // Тач: движение
      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        if (e.touches.length === 1 && isPanning) {
          pX = e.touches[0].clientX - startX;
          pY = e.touches[0].clientY - startY;
          updateTransform();
        } else if (e.touches.length === 2) {
          const dist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const delta = (dist - lastTouchDist) * 0.005;
          scale = Math.min(Math.max(scale + delta, 0.3), 4);
          lastTouchDist = dist;
          updateTransform();
        }
      }, { passive: false });

      // Тач: конец
      canvas.addEventListener('touchend', () => {
        isPanning = false;
      });

      // Инициализация
      updateTransform();
    </script>
  </body>
</html>