---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // 1. Загружаем ВСЕ записи из коллекции
  const allEntries = await getCollection('content');
  
  // 2. Фильтруем только ранние стихи
  const poems = allEntries.filter(entry => 
    entry.id.startsWith('creativity/poems/early-full/')
  );

  // 3. Генерируем пути вручную
  return poems.map((poem) => {
    // Берём только имя файла без расширения (spirit-of-city)
    const slug = poem.id.split('/').pop().replace(/\.md$/, '');
    return {
      params: { slug },
      props: { poem },
    };
  });
}

const { poem } = Astro.props;
const { data, body } = poem;

// Безопасное форматирование даты (если даты нет, выведет пустую строку)
const formattedDate = data.date ? data.date.toLocaleDateString('ru-RU') : '';
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <style>
      body { 
        font-family: 'Georgia', serif; 
        max-width: 600px; 
        margin: 0 auto; 
        padding: 2rem;
        color: #222;
        background: #fafafa;
        line-height: 1.6;
      }
      h1 { 
        font-size: 2rem;
        margin-bottom: 0.5rem;
        text-align: center;
      }
      .date {
        text-align: center;
        color: #888;
        font-size: 0.9rem;
        margin-bottom: 2rem;
        display: block;
        font-style: italic;
      }
      .poem-text {
        font-size: 1.1rem;
        white-space: pre-line;
        margin-bottom: 3rem;
        text-align: center;
      }
      .back { 
        display: inline-block;
        margin-bottom: 2rem;
        color: #666;
        text-decoration: none;
        font-size: 0.9rem;
        font-family: sans-serif;
      }
      .back:hover { color: #000; text-decoration: underline; }
    </style>
  </head>
  <body>
    <a href="./" class="back">← К списку стихов</a>
    
    <h1>{data.title}</h1>
    <span class="date">{formattedDate}</span>
    
    <div class="poem-text">
      {body}
    </div>
  </body>
</html>