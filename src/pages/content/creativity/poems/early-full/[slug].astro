---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const poems = await getCollection('content', ({ id }) => 
    id.startsWith('creativity/poems/early-full/')
  );

  return poems.map((poem) => {
    const slug = poem.id.split('/').pop();
    return {
      params: { slug },
      props: { poem, slug }, // Передаём slug в props
    };
  });
}

const { poem, slug } = Astro.props;
const { data, body } = poem;
const formattedDate = data.date ? data.date.toLocaleDateString('ru-RU') : '';

// Пастельные цвета для фона
const pastelColors = [
  '#FFE5E5', // розовый
  '#E5F3FF', // голубой
  '#FFF5E5', // персиковый
  '#E5FFE5', // мятный
  '#F5E5FF', // лавандовый
  '#FFF9E5', // кремовый
  '#E5FFF9', // бирюзовый
  '#FFE5F0', // нежно-розовый
];

// Выбираем цвет на основе slug
const getColorForPoem = (poemSlug: string) => {
  if (!poemSlug) return '#FAFAFA'; // запасной цвет
  
  let hash = 0;
  for (let i = 0; i < poemSlug.length; i++) {
    hash = poemSlug.charCodeAt(i) + ((hash << 5) - hash);
  }
  const index = Math.abs(hash) % pastelColors.length;
  return pastelColors[index];
};

const bgColor = getColorForPoem(slug);
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body { 
        font-family: 'Helvetica Neue', 'Arial', sans-serif;
        font-weight: 300;
        font-size: 1.05rem;
        line-height: 1.5;
        color: #222;
        background: ${bgColor};
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 5rem 5rem 4rem 8rem !important;
        min-height: 100vh;
      }
      
      .nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }
      
      .nav a {
        color: #666;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 300;
        padding: 0.3rem 0.8rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        transition: all 0.2s;
      }
      
      .nav a:hover {
        color: #222;
        border-color: #888;
        background: rgba(255,255,255,0.5);
      }
      
      h1 { 
        font-size: 1.6rem;
        font-weight: 300;
        margin-bottom: 1.5rem;
        text-align: left;
        letter-spacing: 0.5px;
      }
      
      .poem-text {
        font-size: 1.05rem;
        line-height: 1.6;
        white-space: pre-line;
        text-align: left;
        margin-bottom: 0.5rem;
        font-weight: 300;
        max-width: 600px;
      }

      .date {
        text-align: right;
        color: #666;
        font-size: 0.85rem;
        font-style: italic;
        margin-top: 1rem;
        margin-right: 1rem;
        align-self: flex-end;
        width: 100%;
        max-width: 600px;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
      <a href="./">← К ранним полноценкам</a>
    </nav>
    
    <h1>{data.title}</h1>
    
    <div class="poem-text">
      {body}
    </div>
    
    <div class="date">{formattedDate}</div>
  </body>
</html>