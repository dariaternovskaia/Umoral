---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const poems = await getCollection('content', ({ id }) => 
    id.startsWith('creativity/poems/early-full/')
  );

  return poems.map((poem) => {
    const slug = poem.id.split('/').pop();
    return {
      params: { slug },
      props: { poem },
    };
  });
}

const { poem } = Astro.props;
const { data, body } = poem;
const formattedDate = data.date ? data.date.toLocaleDateString('ru-RU') : '';
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body { 
        font-family: 'Helvetica Neue', 'Arial', sans-serif;
        font-weight: 300;
        font-size: 1.05rem;
        line-height: 1.5;
        color: #222;
        background: #fafafa;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        
        /* ВОТ ЭТА СТРОКА: 12rem слева + !important чтобы точно сработало */
        padding: 5rem 5rem 4rem 12rem !important; 
        min-height: 100vh;
      }
      
      h1 { 
        font-size: 1.6rem;
        font-weight: 300;
        margin-bottom: 1.5rem;
        text-align: left;
        letter-spacing: 0.5px;
      }
      
      .poem-text {
        font-size: 1.05rem;
        line-height: 1.6;
        white-space: pre-line;
        text-align: left;
        margin-bottom: 0.5rem;
        font-weight: 300;
        max-width: 600px;
      }

      .date {
        text-align: right;
        color: #666;
        font-size: 0.85rem;
        font-style: italic;
        margin-top: 1rem;
        margin-right: 1rem;
        align-self: flex-end;
        width: 100%;
        max-width: 600px;
      }

      .back { 
        display: inline-block;
        margin-bottom: 2rem;
        color: #888;
        text-decoration: none;
        font-size: 0.85rem;
        font-family: 'Helvetica Neue', 'Arial', sans-serif;
        font-weight: 300;
      }
      .back:hover { color: #222; text-decoration: underline; }
    </style>
  </head>
  <body>
    <a href="./" class="back">← К списку стихов</a>
    
    <h1>{data.title}</h1>
    
    <div class="poem-text">
      {body}
    </div>
    
    <div class="date">{formattedDate}</div>
  </body>
</html>