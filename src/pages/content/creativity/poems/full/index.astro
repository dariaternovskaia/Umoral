---
import { getCollection } from 'astro:content';

let poems = await getCollection('content', ({ id }) => id.startsWith('creativity/poems/full/'));
poems = poems.filter(note => !note.data.draft);
poems.sort((a, b) => new Date(b.data.date || 0) - new Date(a.data.date || 0));
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>Полноценки | Umoral</title>
    <style>
      body { 
        font-family: sans-serif; 
        max-width: 600px; 
        margin: 0 auto; 
        padding: 2rem;
        color: #f0f0f0; 
        background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)), url('/Umoral/bg-early-poems.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
      }
      
      .nav { display: flex; gap: 1.5rem; margin-bottom: 2rem; }

      h1 { 
        font-size: 1.4rem; margin-bottom: 1.5rem; padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.3); color: #fff;
      }
      
      .poem-link {
        display: block; text-decoration: none; color: #e5e5e5;
        padding: 0.8rem 0; border-bottom: 1px dashed rgba(255, 255, 255, 0.2);
        transition: all 0.2s; cursor: pointer;
      }
      .poem-link:hover {
        background: rgba(255, 255, 255, 0.1); padding-left: 0.5rem;
        border-bottom-style: solid; color: #fff;
      }
      .poem-title { font-weight: 600; font-size: 1rem; }
      
      .back { color: #bbb; text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
      .back:hover { color: #fff; }
    </style>
  </head>
  <body>
    <div class="nav">
      <a href="/Umoral/" class="back">← На главную</a>
      <a href="/Umoral/content/creativity/poems/" class="back">← К стихам</a>
    </div>
    
    <h1>Полноценки</h1>
    
    <div>
      {poems.map((poem) => {
        const slug = poem.id.split('/').pop();
        return (
          <a href={`/Umoral/content/creativity/poems/full/${slug}/`} class="poem-link">
            <span class="poem-title">{poem.data.title}</span>
          </a>
        );
      })}
    </div>
  </body>
</html>