---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const poems = await getCollection('content', ({ id }) => 
    id.startsWith('creativity/poems/early-full/')
  );

  return poems.map((poem) => {
    const slug = poem.id.split('/').pop();
    return {
      params: { slug },
      props: { poem, slug },
    };
  });
}

const { poem, slug } = Astro.props;
const { data, body } = poem;
const formattedDate = data.date ? data.date.toLocaleDateString('ru-RU') : '';

// Тёмные глубокие цвета (20 оттенков)
const darkColors = [
  '#0F172A', // Slate 900 - тёмный грифельный
  '#1E1B4B', // Indigo 950 - глубокий индиго
  '#064E3B', // Emerald 900 - тёмный изумруд
  '#290028', // Deep Magenta - тёмная маджента
  '#1C1917', // Stone 900 - угольный
  '#0C1929', // Navy 950 - тёмно-морской
  '#141414', // Graphite - графит
  '#1A1A2E', // Deep Navy - глубокий тёмно-синий
  '#1B1B3A', // Royal Navy - королевский синий
  '#2D1B4E', // Deep Purple - глубокий фиолетовый
  '#0F2F2E', // Dark Teal - тёмный бирюзовый
  '#2E1A1A', // Dark Burgundy - тёмный бордо
  '#1A2F1A', // Forest Night - лесная ночь
  '#2A1F3D', // Twilight Purple - сумеречный фиолетовый
  '#0D1B2A', // Midnight Blue - полуночный синий
  '#1B263B', // Deep Ocean - глубокий океан
  '#2D2416', // Dark Chocolate - тёмный шоколад
  '#1A1A2E', // Cosmic Blue - космический синий
  '#2E1B2E', // Dark Plum - тёмная слива
  '#0F1419', // Void Black - чёрная пустота
];

const getColorForPoem = (poemSlug: string) => {
  if (!poemSlug) return '#1A1A2E';
  let hash = 0;
  for (let i = 0; i < poemSlug.length; i++) {
    hash = poemSlug.charCodeAt(i) + ((hash << 5) - hash);
  }
  const index = Math.abs(hash) % darkColors.length;
  return darkColors[index];
};

const bgColor = getColorForPoem(slug);
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body { 
        font-family: 'Helvetica Neue', 'Arial', sans-serif;
        font-weight: 300;
        font-size: 1.05rem;
        line-height: 1.5;
        color: #f0f0f0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 5rem 5rem 4rem 8rem !important;
        min-height: 100vh;
      }
      
      .nav {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
        flex-wrap: wrap;
      }
      
      .nav a {
        color: #aaa;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 300;
        padding: 0.3rem 0.8rem;
        border: 1px solid #444;
        border-radius: 4px;
        transition: all 0.2s;
      }
      
      .nav a:hover {
        color: #fff;
        border-color: #888;
        background: rgba(255,255,255,0.1);
      }
      
      h1 { 
        font-size: 1.6rem;
        font-weight: 300;
        margin-bottom: 1.5rem;
        text-align: left;
        letter-spacing: 0.5px;
        color: #fff;
      }
      
      .poem-text {
        font-size: 1.05rem;
        line-height: 1.6;
        white-space: pre-line;
        text-align: left;
        margin-bottom: 0.5rem;
        font-weight: 300;
        max-width: 600px;
        color: #e5e5e5;
      }

      .date {
        text-align: right;
        color: #888;
        font-size: 0.85rem;
        font-style: italic;
        margin-top: 1rem;
        margin-right: 1rem;
        align-self: flex-end;
        width: 100%;
        max-width: 600px;
      }
    </style>
  </head>
  <body style={`background-color: ${bgColor};`}>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
      <a href="/Umoral/content/creativity/poems/early-full/">← К ранним полноценкам</a>
    </nav>
    
    <h1>{data.title}</h1>
    
    <div class="poem-text">
      {body}
    </div>
    
    <div class="date">{formattedDate}</div>
  </body>
</html>