---
import { getCollection } from 'astro:content';

const poems = await getCollection('content', ({ id }) => 
  id.startsWith('creativity/poems/current-full/')
);

// Создаём сетку 4x4 (16 ячеек)
const totalCells = 16;
const filledCells = poems.map(poem => ({
  slug: poem.id.split('/').pop().replace('.md', ''),
  title: poem.data.title,
  cover: poem.data.cover || '',
  date: poem.data.date,
}));

// Заполняем оставшиеся ячейки пустыми
const cells = [];
for (let i = 0; i < totalCells; i++) {
  if (i < filledCells.length) {
    cells.push({ type: 'filled', ...filledCells[i] });
  } else {
    cells.push({ type: 'empty' });
  }
}
---

<html>
  <head>
    <title>Актуальные полноценки | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: #fafafa;
        min-height: 100vh;
        padding: 3rem 2rem;
      }

      h1 {
        text-align: center;
        color: #222;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 300;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: 800px;
        margin: 0 auto;
        border: 2px solid #000;
      }

      .cell {
        aspect-ratio: 1;
        background: #fff;
        border: 1px solid #000;
        overflow: hidden;
        transition: all 0.2s;
        cursor: pointer;
        display: flex;
        flex-direction: column;
      }

      .cell:hover {
        background: #f0f0f0;
      }

      .cell-image {
        width: 100%;
        height: 75%;
        object-fit: cover;
        border-bottom: 1px solid #000;
      }

      .cell-title {
        height: 25%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.5rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: #222;
        background: #fff;
      }

      /* Пустая ячейка */
      .cell.empty {
        background: #f5f5f5;
        cursor: default;
        display: flex;
        align-items: center;
        justify-content: center;
      }

      .cell.empty:hover {
        background: #f5f5f5;
      }

      .question-mark {
        font-size: 3rem;
        color: #999;
        font-weight: 300;
      }

      .back-link {
        display: block;
        text-align: center;
        margin-top: 3rem;
        color: #666;
        text-decoration: none;
        font-size: 1rem;
      }
      .back-link:hover { color: #000; text-decoration: underline; }

      @media (max-width: 900px) {
        .grid { grid-template-columns: repeat(3, 1fr); }
      }

      @media (max-width: 650px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
        h1 { font-size: 1.8rem; }
      }
    </style>
  </head>
  <body>
    <h1>Актуальные полноценки</h1>
    
    <div class="grid">
      {cells.map((cell) => {
        if (cell.type === 'filled') {
          return (
            <a href={`/Umoral/content/creativity/poems/current-full/${cell.slug}/`} class="cell">
              <img src={`/Umoral/${cell.cover}`} alt={cell.title} class="cell-image" />
              <div class="cell-title">{cell.title}</div>
            </a>
          );
        } else {
          return (
            <div class="cell empty">
              <div class="question-mark">?</div>
            </div>
          );
        }
      })}
    </div>

    <a href="/Umoral/content/creativity/poems/" class="back-link">← К стихам</a>
  </body>
</html>