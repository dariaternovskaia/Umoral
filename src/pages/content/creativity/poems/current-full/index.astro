---
import { getCollection } from 'astro:content';

const poems = await getCollection('content', ({ id }) => 
  id.startsWith('creativity/poems/current-full/')
);

const totalCells = 16;
const filledCells = poems.map(poem => ({
  slug: poem.id.split('/').pop().replace('.md', ''),
  title: poem.data.title,
  cover: poem.data.cover || null,
  date: poem.data.date,
}));

const cells = [];
for (let i = 0; i < totalCells; i++) {
  if (i < filledCells.length) {
    cells.push({ type: 'filled', ...filledCells[i] });
  } else {
    cells.push({ type: 'empty' });
  }
}
---

<html>
  <head>
    <title>Актуальные полноценки | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/Umoral/bg-current-full.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        padding: 5rem 2rem 8rem 2rem; /* ← Изменил нижний отступ на 8rem */
      }

      .nav { display: flex; justify-content: center; gap: 1rem; margin-bottom: 3rem; }
      .nav a {
        color: rgba(255,255,255,0.8); text-decoration: none; font-size: 0.9rem;
        padding: 0.3rem 0.8rem; border: 1px solid rgba(255,255,255,0.3); border-radius: 4px;
        transition: all 0.2s; backdrop-filter: blur(5px);
      }
      .nav a:hover { color: #fff; border-color: #fff; background: rgba(255,255,255,0.1); }

      h1 {
        text-align: center;
        color: #fff;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 300;
        text-shadow: 0 2px 15px rgba(0,0,0,0.8);
        letter-spacing: 1px;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: 800px;
        margin: 0 auto;
        border: 2px solid rgba(255, 255, 255, 0.8);
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        overflow: hidden;
      }

      .cell {
        aspect-ratio: 1;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        border: 1px solid rgba(0, 0, 0, 0.3);
      }

      .cell:hover {
        transform: scale(1.03);
        z-index: 2;
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
      }

      .cell-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .cell-title {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 1rem 0.5rem;
        text-align: center;
        font-size: 0.95rem;
        font-weight: 500;
        color: #fff;
        background: linear-gradient(to top, rgba(0,0,0,0.8), transparent);
        backdrop-filter: blur(3px);
        text-shadow: 0 1px 3px rgba(0,0,0,0.8);
        letter-spacing: 0.5px;
      }

      .cell.empty {
        background: rgba(255, 255, 255, 0.08);
        backdrop-filter: blur(8px);
        cursor: default;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.15);
      }

      .cell.empty:hover {
        background: rgba(255, 255, 255, 0.12);
        transform: none;
        box-shadow: none;
        z-index: auto;
      }

      .question-mark {
        font-size: 2.5rem;
        color: rgba(255, 255, 255, 0.3);
        font-weight: 200;
      }

      @media (max-width: 900px) {
        .grid { grid-template-columns: repeat(3, 1fr); }
      }

      @media (max-width: 650px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
        h1 { font-size: 1.8rem; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
    </nav>
    
    <h1>Актуальные полноценки</h1>
    
    <div class="grid">
      {cells.map((cell) => {
        if (cell.type === 'filled') {
          return (
            <a href={`/Umoral/content/creativity/poems/current-full/${cell.slug}/`} class="cell">
              <img src={`/Umoral/${cell.cover}`} alt={cell.title} class="cell-image" />
              <div class="cell-title">{cell.title}</div>
            </a>
          );
        } else {
          return (
            <div class="cell empty">
              <div class="question-mark">?</div>
            </div>
          );
        }
      })}
    </div>
  </body>
</html>