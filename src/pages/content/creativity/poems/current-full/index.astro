---
import { getCollection } from 'astro:content';

const poems = await getCollection('content', ({ id }) => 
  id.startsWith('creativity/poems/current-full/')
);

const totalCells = 16;
const filledCells = poems.map(poem => ({
  slug: poem.id.split('/').pop().replace('.md', ''),
  title: poem.data.title,
  cover: poem.data.cover || null,
  date: poem.data.date,
}));

const cells = [];
for (let i = 0; i < totalCells; i++) {
  if (i < filledCells.length) {
    cells.push({ type: 'filled', ...filledCells[i] });
  } else {
    cells.push({ type: 'empty' });
  }
}
---

<html>
  <head>
    <title>Актуальные полноценки | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(rgba(0, 0, 0, 0.5), rgba(0, 0, 0, 0.5)), url('/Umoral/bg-current-full.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        min-height: 100vh;
        padding: 3rem 2rem;
      }

      h1 {
        text-align: center;
        color: #fff;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 300;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        max-width: 800px;
        margin: 0 auto;
        border: 3px solid #fff;
        box-shadow: 0 0 30px rgba(0,0,0,0.5);
      }

      .cell {
        aspect-ratio: 1;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #000;
        overflow: hidden;
        transition: all 0.2s;
        cursor: pointer;
        display: flex;
        flex-direction: column;
      }

      .cell:hover {
        background: rgba(255, 255, 255, 1);
        transform: scale(1.02);
      }

      .cell-image {
        width: 100%;
        height: 75%;
        object-fit: cover;
        border-bottom: 1px solid #000;
      }

      .cell-title {
        height: 25%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 0.5rem;
        font-size: 0.95rem;
        font-weight: 500;
        color: #222;
        background: rgba(255, 255, 255, 0.95);
      }

      .cell.empty {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(5px);
        cursor: default;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.3);
      }

      .cell.empty:hover {
        background: rgba(255, 255, 255, 0.2);
      }

      .question-mark {
        font-size: 3rem;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 300;
      }

      .back-link {
        display: block;
        text-align: center;
        margin-top: 3rem;
        color: #fff;
        text-decoration: none;
        font-size: 1rem;
        text-shadow: 0 1px 5px rgba(0,0,0,0.5);
      }
      .back-link:hover { color: #fff; text-decoration: underline; }

      @media (max-width: 900px) {
        .grid { grid-template-columns: repeat(3, 1fr); }
      }

      @media (max-width: 650px) {
        .grid { grid-template-columns: repeat(2, 1fr); }
        h1 { font-size: 1.8rem; }
      }
    </style>
  </head>
  <body>
    <h1>Актуальные полноценки</h1>
    
    <div class="grid">
      {cells.map((cell) => {
        if (cell.type === 'filled') {
          return (
            <a href={`/Umoral/content/creativity/poems/current-full/${cell.slug}/`} class="cell">
              {cell.cover && <img src={`/Umoral/${cell.cover}`} alt={cell.title} class="cell-image" />}
              <div class="cell-title">{cell.title}</div>
            </a>
          );
        } else {
          return (
            <div class="cell empty">
              <div class="question-mark">?</div>
            </div>
          );
        }
      })}
    </div>

    <a href="/Umoral/content/creativity/poems/" class="back-link">← К стихам</a>
  </body>
</html>