---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const poems = await getCollection('content', ({ id }) => 
    id.startsWith('creativity/poems/current-full/')
  );

  return poems.map((poem) => {
    const slug = poem.id.split('/').pop().replace('.md', '');
    return {
      params: { slug },
      props: { poem, slug },
    };
  });
}

const { poem, slug } = Astro.props;
const { data, body } = poem;
const formattedDate = data.date ? data.date.toLocaleDateString('ru-RU') : '';

// Разбиваем на строки для стиха
const lines = body ? body.split('\n').filter(line => line.trim() !== '') : [];
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        font-weight: 300;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #f0f0f0;
        min-height: 100vh;
        padding: 5rem 15% 4rem 15%;
        background-color: #1A1A2E;
      }
      
      .nav { display: flex; gap: 1rem; margin-bottom: 2rem; }
      .nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem;
        padding: 0.3rem 0.8rem; border: 1px solid #444; border-radius: 4px;
        transition: all 0.2s;
      }
      .nav a:hover { color: #fff; border-color: #888; background: rgba(255,255,255,0.1); }
      
      h1 { 
        font-size: 2.2rem; 
        font-weight: 300; 
        margin-bottom: 0.5rem; 
        color: #fff; 
        text-align: center;
      }
      
      .date { 
        color: #888; 
        font-size: 0.9rem; 
        font-style: italic; 
        margin-bottom: 3rem; 
        display: block;
        text-align: center;
      }
      
      .poem-container {
        max-width: 600px;
        margin: 0 auto;
      }
      
      .poem-text {
        font-size: 1.1rem;
        line-height: 2;
        white-space: pre-line;
        text-align: center;
        color: #e5e5e5;
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/poems/">← К стихам</a>
      <a href="/Umoral/content/creativity/poems/current-full/">← К актуальным</a>
    </nav>
    
    <h1>{data.title}</h1>
    <span class="date">{formattedDate}</span>
    
    <div class="poem-container">
      <div class="poem-text">
        {lines.map(line => <div>{line}</div>)}
      </div>
    </div>
  </body>
</html>