---

<html>
  <head>
    <title>Стихи | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3)), url('/Umoral/bg-concert.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        background-repeat: no-repeat;
        color: #222;
        min-height: 100vh;
        padding: 2rem;
      }

      /* Простое центрирование через margin */
      .main-content {
        max-width: 1000px;
        margin: 6rem auto 0 auto;
        padding: 0 2rem;
      }

      h1 {
        font-size: 2.8rem;
        margin-bottom: 3rem;
        font-weight: 700;
        text-align: center;
        color: #fff;
      }
      
      .boxes-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
        margin-bottom: 3rem;
      }
      
      .box {
        background: #fff;
        border: 2.5px solid #333;
        border-radius: 16px;
        padding: 2.5rem 1rem;
        text-align: center;
        font-size: 1.1rem;
        font-weight: 700;
        text-decoration: none;
        color: #333;
        transition: all 0.2s;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 140px;
        line-height: 1.4;
        box-shadow: 0 4px 6px rgba(0,0,0,0.05);
      }
      .box:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        border-color: #000;
      }

      .back-link {
        display: block;
        text-align: center;
        margin-top: 1rem;
        margin-bottom: 2rem;
        color: #fff;
        text-decoration: none;
        font-size: 1.1rem;
      }
      .back-link:hover {
        color: #fff;
        text-decoration: underline;
      }

      @media (max-width: 1000px) {
        .boxes-grid {
          grid-template-columns: repeat(2, 1fr);
          max-width: 600px;
          margin-left: auto;
          margin-right: auto;
        }
      }

      @media (max-width: 650px) {
        .main-content {
          margin-top: 3rem;
        }
        h1 {
          font-size: 2rem;
        }
        .box {
          padding: 1.5rem 0.5rem;
          min-height: 100px;
          font-size: 0.9rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="main-content">
      <h1>Стихи</h1>
      
      <div class="boxes-grid">
        <a href="/Umoral/content/creativity/poems/early-full/" class="box">Ранние полноценки</a>
        <a href="/Umoral/content/creativity/poems/current-full/" class="box">Актуальные полноценки</a>
        <a href="/Umoral/content/creativity/poems/philosophy/" class="box">Философия в стихах</a>
        <a href="/Umoral/content/creativity/poems/exercises/" class="box">Упражнения</a>
      </div>

      <a href="/Umoral/" class="back-link">← На главную</a>
    </div>
  </body>
</html>