---
import { getEntry } from 'astro:content';

const prose = await getEntry('content', 'creativity/prose/myth-sketch');
const { data, body } = prose;
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        font-weight: 300;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #f0f0f0;
        min-height: 100vh;
        padding: 5rem 15% 4rem 15%; /* Поля 15% */
        background-color: #2D1B4E;
        position: relative;
        overflow-x: visible; /* Разрешаем видеть поля */
      }
      
      .nav { display: flex; gap: 1rem; margin-bottom: 2rem; }
      .nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem;
        padding: 0.3rem 0.8rem; border: 1px solid #444; border-radius: 4px;
      }
      .nav a:hover { color: #fff; border-color: #888; }
      
      h1 { font-size: 2rem; font-weight: 300; margin-bottom: 0.5rem; color: #fff; }
      .date { color: #888; font-size: 0.9rem; font-style: italic; margin-bottom: 3rem; display: block; }
      
      .prose-text {
        max-width: 800px;
        margin: 0 auto;
        text-align: justify;
        hyphens: auto;
      }
      
      .prose-text p {
        margin-bottom: 1.5rem;
        text-indent: 2rem;
        position: relative; /* Родитель для абсолютного позиционирования */
      }
      .prose-text p:first-child { text-indent: 0; }

      /* Рукописная заметка */
      .handwritten-note {
        position: absolute;
        right: 0; /* Начинаем от правого края текста */
        top: 0;
        font-family: 'Caveat', cursive;
        font-weight: 600;
        font-size: 1.5rem;
        color: #ffffff;
        line-height: 1.3;
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        white-space: nowrap; /* Не переносить слова */
        /* Сдвигаем вправо на 120px от края текста */
        transform: translateX(120px) rotate(-4deg);
      }

      /* Заметка в углу (фиксированная) */
      .corner-note {
        position: fixed;
        top: 6rem;
        right: 3rem;
        font-family: 'Caveat', cursive;
        font-weight: 600;
        font-size: 1.4rem;
        color: #fff;
        text-align: right;
        transform: rotate(12deg);
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        z-index: 10;
      }

      /* Адаптив: на планшетах и телефонах заметки скрываем, чтобы не мешали */
      @media (max-width: 1100px) {
        .handwritten-note { display: none; }
        .corner-note { right: 1rem; font-size: 1.1rem; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/prose/">← К прозе</a>
    </nav>
    
    <h1>{data.title}</h1>
    <span class="date">{data.date.toLocaleDateString('ru-RU')}</span>
    
    <!-- Заметка в углу -->
    <div class="corner-note">
      в копилку историй<br/>о безымянных Богах
    </div>
    
    <div class="prose-text" set:html={body} />
    
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const paragraphs = document.querySelectorAll('.prose-text p');
        
        paragraphs.forEach(p => {
          const text = p.textContent || '';
          const lower = text.toLowerCase();
          
          // 1. Ищем абзац "Однако наказания..."
          if (lower.startsWith('однако наказ')) {
            const note = document.createElement('div');
            note.className = 'handwritten-note';
            note.textContent = 'использовать в качестве аргумента\nв споре о наличие души\nу аборигенов';
            note.style.top = '10px';
            p.appendChild(note);
          }
          
          // 2. Ищем "европейский бог"
          if (lower.includes('европейский бог')) {
            const note = document.createElement('div');
            note.className = 'handwritten-note';
            note.textContent = 'любителям русского\nБога посвящается';
            // Сдвигаем чуть выше, чтобы не наезжать
            note.style.top = '-50px';
            p.appendChild(note);
          }
        });
      });
    </script>
  </body>
</html>