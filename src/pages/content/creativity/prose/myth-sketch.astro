---
import { getEntry } from 'astro:content';

const prose = await getEntry('content', 'creativity/prose/myth-sketch');
const { data, body } = prose;
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <!-- Шрифт Caveat (рукописный) -->
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        font-weight: 300;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #f0f0f0;
        min-height: 100vh;
        padding: 5rem 2rem 4rem 2rem;
        background-color: #2D1B4E;
      }
      
      .nav { display: flex; gap: 1rem; margin-bottom: 2rem; }
      .nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem;
        padding: 0.3rem 0.8rem; border: 1px solid #444; border-radius: 4px;
      }
      .nav a:hover { color: #fff; border-color: #888; }
      
      h1 { text-align: center; font-size: 2rem; margin-bottom: 0.5rem; color: #fff; }
      .date { text-align: center; color: #888; margin-bottom: 3rem; display: block; }

      /* === КОНТЕЙНЕР ДЛЯ ТЕКСТА === */
      /* Делаем его узким (650px), чтобы слева и справа было пустое место для заметок */
      #prose-container {
        max-width: 650px;
        margin: 0 auto;
        position: relative; /* Важно! Заметки позиционируются относительно этого блока */
      }

      .prose-text {
        text-align: justify;
        hyphens: auto;
      }
      
      .prose-text p { margin-bottom: 1.5rem; text-indent: 2rem; }
      .prose-text p:first-child { text-indent: 0; }

      /* === СТИЛИ ЗАМЕТОК === */
      .handwritten-note {
        position: absolute;
        font-family: 'Caveat', cursive;
        font-weight: 600;
        font-size: 1.6rem; /* Крупно */
        color: #ffffff;
        line-height: 1.2;
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        white-space: nowrap;
      }

      /* 1. Заметка "В копилку..." в правом верхнем углу */
      .note-corner {
        top: 0;
        right: -260px; /* Висит справа от узкого текста */
        transform: rotate(15deg);
        text-align: right;
      }

      /* 2. Заметка про душу (напротив первого абзаца) */
      .note-soul {
        top: 150px; /* Приблизительно напротив начала длинного абзаца */
        right: -350px; /* Сдвигаем вправо, в поля */
        transform: rotate(-5deg);
        text-align: left;
      }

      /* 3. Заметка про русского бога (со стрелкой) */
      .note-god {
        top: 380px; /* Чуть ниже предыдущей */
        right: -320px; /* В полях */
        transform: rotate(3deg);
        display: flex;
        align-items: center;
        gap: 10px;
      }

      /* Стрелочка */
      .hand-arrow {
        width: 40px;
        height: 2px;
        background: white;
        position: relative;
        transform: rotate(180deg); /* Стрелка смотрит влево к тексту */
        box-shadow: 0 0 3px rgba(255,255,255,0.5);
      }
      .hand-arrow::after {
        content: '';
        position: absolute;
        left: 0; top: -4px;
        border-left: 8px solid white;
        border-top: 5px solid transparent;
        border-bottom: 5px solid transparent;
      }

      /* Фигурная скобка (рисуем через border или символ) */
      .brace {
        position: absolute;
        left: -30px;
        top: 120px;
        font-family: 'Caveat', cursive;
        font-size: 8rem;
        color: rgba(255,255,255,0.6);
        transform: rotate(90deg);
        line-height: 1;
      }

      /* Адаптив для телефонов (убираем поля) */
      @media (max-width: 1000px) {
        .handwritten-note { display: none; } /* Скрываем заметки на мелких экранах */
        .brace { display: none; }
        #prose-container { max-width: 100%; }
      }
    </style>
  </head>
  <body>
    <nav class="nav" style="justify-content: center;">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/prose/">← К прозе</a>
    </nav>
    
    <h1>{data.title}</h1>
    <span class="date">{data.date.toLocaleDateString('ru-RU')}</span>

    <div id="prose-container">
      <!-- Фигурная скобка -->
      <div class="brace">{'{'}</div>

      <!-- Текст -->
      <div class="prose-text" set:html={body} />

      <!-- Заметка 1: Угол -->
      <div class="handwritten-note note-corner">
        в копилку историй<br/>о безымянных Богах
      </div>

      <!-- Заметка 2: Про душу -->
      <div class="handwritten-note note-soul">
        использовать в качестве аргумента<br/>
        в споре о наличие души<br/>
        у аборигенов
      </div>

      <!-- Заметка 3: Про Бога со стрелкой -->
      <div class="handwritten-note note-god">
        <div class="hand-arrow"></div>
        <span>
          любителям русского<br/>
          Бога посвящается
        </span>
      </div>
    </div>
  </body>
</html>