---
import { getEntry } from 'astro:content';

const prose = await getEntry('content', 'creativity/prose/myth-sketch');
const { data, body } = prose;
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        font-weight: 300;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #f0f0f0;
        min-height: 100vh;
        padding: 5rem 0 4rem 0;
        background-color: #2D1B4E;
      }
      
      .nav { 
        display: flex; gap: 1rem; margin-bottom: 2rem; 
        justify-content: center;
      }
      .nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem;
        padding: 0.3rem 0.8rem; border: 1px solid #444; border-radius: 4px;
      }
      .nav a:hover { color: #fff; border-color: #888; }
      
      h1 { text-align: center; font-size: 2rem; margin-bottom: 0.5rem; color: #fff; }
      .date { text-align: center; color: #888; font-size: 0.9rem; margin-bottom: 3rem; display: block; }

      .page-layout {
        position: relative;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      .text-content {
        max-width: 650px;
        margin: 0 auto;
        text-align: justify;
        hyphens: auto;
        position: relative;
      }
      
      .text-content p { margin-bottom: 1.5rem; text-indent: 2rem; }
      .text-content p:first-child { text-indent: 0; }

      /* Стили заметок */
      .handwritten {
        position: absolute;
        font-family: 'Caveat', cursive;
        font-weight: 600;
        font-size: 1.6rem;
        color: #fff;
        line-height: 1.2;
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        white-space: pre-wrap;
        max-width: 250px;
        z-index: 10;
      }

      @media (max-width: 1000px) {
        .handwritten { display: none; }
        .page-layout { padding: 0 1rem; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/prose/">← К прозе</a>
    </nav>
    
    <h1>{data.title}</h1>
    <span class="date">{data.date.toLocaleDateString('ru-RU')}</span>
    
    <div class="page-layout">
      
      <!-- Текст по центру -->
      <div class="text-content" set:html={body} />

      <!-- 1. Заметка "В копилку..." (Правый верхний угол, сдвинута вправо и вверх) -->
      <div class="handwritten" style="top: 20px; right: 100px; transform: rotate(12deg);">
        в копилку историй<br/>о безымянных Богах
      </div>

      <!-- 2. Заметка "Использовать..." (Справа, опущена в 2.5 раза ниже) -->
      <div class="handwritten" style="top: 1120px; right: 10px; transform: rotate(-4deg);">
        использовать в качестве аргумента<br/>
        в споре о наличие души<br/>
        у аборигенов
      </div>

      <!-- 3. Заметка "Любителям..." (Слева, опущена в 3 раза ниже) -->
      <!-- Используем left вместо right, чтобы прижать к левому краю -->
      <div class="handwritten" style="top: 2050px; left: 20px; transform: rotate(3deg);">
        любителям русского<br/>
        Бога посвящается
      </div>

    </div>
  </body>
</html>