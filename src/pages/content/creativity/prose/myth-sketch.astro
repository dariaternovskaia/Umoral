---
import { getEntry } from 'astro:content';

const prose = await getEntry('content', 'creativity/prose/myth-sketch');
const { data, body } = prose;
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>{data.title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: 'Georgia', serif;
        font-weight: 300;
        font-size: 1.1rem;
        line-height: 1.8;
        color: #f0f0f0;
        min-height: 100vh;
        padding: 5rem 0 4rem 0;
        background-color: #2D1B4E;
      }
      
      .nav { 
        display: flex; gap: 1rem; margin-bottom: 2rem; 
        justify-content: center;
      }
      .nav a {
        color: #aaa; text-decoration: none; font-size: 0.85rem;
        padding: 0.3rem 0.8rem; border: 1px solid #444; border-radius: 4px;
      }
      .nav a:hover { color: #fff; border-color: #888; }
      
      h1 { text-align: center; font-size: 2rem; margin-bottom: 0.5rem; color: #fff; }
      .date { text-align: center; color: #888; font-size: 0.9rem; margin-bottom: 3rem; display: block; }

      .page-layout {
        position: relative;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      .text-content {
        max-width: 650px;
        margin: 0 auto;
        text-align: justify;
        hyphens: auto;
      }
      
      .text-content p { margin-bottom: 1.5rem; text-indent: 2rem; }
      .text-content p:first-child { text-indent: 0; }

      /* Базовые стили заметок */
      .handwritten {
        font-family: 'Caveat', cursive;
        font-weight: 600;
        font-size: 1.6rem;
        color: #fff;
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
        z-index: 10;
      }

      /* 1. Угловая заметка */
      .note-corner {
        position: fixed;
        top: 50px;
        right: 30px;
        transform: rotate(12deg);
        white-space: nowrap;
      }

      /* 2. Правая заметка (Использовать...) */
      .note-soul {
        position: absolute;
        /* Принудительно 2 строки + плотный интервал */
        width: 220px; 
        line-height: 0.85; 
        text-align: right;
      }

      /* 3. Левая заметка (Любителям...) */
      .note-god {
        position: absolute;
        white-space: nowrap;
      }

      @media (max-width: 1000px) {
        .handwritten { display: none; }
        .page-layout { padding: 0 1rem; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/creativity/prose/">← К прозе</a>
    </nav>
    
    <h1>{data.title}</h1>
    <span class="date">{data.date.toLocaleDateString('ru-RU')}</span>
    
    <div class="page-layout">
      
      <div class="text-content" set:html={body} />

      <!-- Заметка 1: В углу -->
      <div class="handwritten note-corner">
        в копилку историй о безымянных Богах
      </div>

      <!-- Заметка 2: Справа (ровно 2 строки, плотный интервал) -->
      <div class="handwritten note-soul" 
           style="top: 1430px; right: -80px; transform: rotate(-4deg);">
        использовать в качестве аргумента<br>
        в споре о наличие души у аборигенов
      </div>

      <!-- Заметка 3: Слева (сдвинута влево на длину слова "посвящается") -->
      <div class="handwritten note-god" 
           style="top: 1980px; left: -140px; transform: rotate(3deg);">
        любителям русского Бога посвящается
      </div>

    </div>
  </body>
</html>