---
export const prerender = true;
---

<html>
  <head>
    <title>Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/Umoral/bg-hospital.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        color: #fff;
        padding: 5rem 2rem 3rem;
        position: relative;
        overflow-x: hidden;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
        z-index: 20;
      }
      .nav a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
        background: rgba(0,0,0,0.3);
        transition: all 0.3s ease;
      }
      .nav a:hover {
        color: #fff;
        border-color: #fff;
        background: rgba(0,0,0,0.5);
      }

      .content {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 20;
      }

      .circles-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 10;
      }

      .green-circle {
        position: absolute;
        width: 100px;
        height: 100px;
        background-color: rgba(76, 175, 80, 0.85);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: white;
        font-size: 0.85rem;
        text-align: center;
        padding: 10px;
        box-shadow: 0 4px 15px rgba(76, 175, 80, 0.5);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        pointer-events: auto;
        border: 2px solid rgba(255, 255, 255, 0.4);
        font-weight: bold;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
      }

      .green-circle:hover {
        background-color: rgba(69, 160, 73, 1);
        transform: scale(1.15);
        box-shadow: 0 8px 25px rgba(76, 175, 80, 0.8);
        border-color: #fff;
      }

      .circle-1 {
        top: 25%;
        left: 15%;
      }

      .circle-2 {
        top: 65%;
        left: 75%;
      }

      .circle-deco-1 {
        top: 45%;
        left: 85%;
        width: 50px;
        height: 50px;
        background-color: rgba(76, 175, 80, 0.4);
        pointer-events: none;
      }

      .circle-deco-2 {
        top: 85%;
        left: 25%;
        width: 40px;
        height: 40px;
        background-color: rgba(76, 175, 80, 0.5);
        pointer-events: none;
      }

      .circle-deco-3 {
        top: 15%;
        left: 65%;
        width: 60px;
        height: 60px;
        background-color: rgba(76, 175, 80, 0.3);
        pointer-events: none;
      }

      @media (max-width: 600px) {
        .green-circle {
          width: 80px;
          height: 80px;
          font-size: 0.7rem;
        }
        .circle-1 { top: 20%; left: 10%; }
        .circle-2 { top: 70%; left: 65%; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/content/philosophy/essays/">← Назад</a>
      <a href="/Umoral/">← На главную</a>
    </nav>

    <div class="circles-container">
      <a href="https://dariaternovskaia.github.io/Umoral/content/philosophy/essays/reading-diary/krasznahorkai/" class="green-circle circle-1">
        Краснахоркаи
      </a>
      
      <a href="https://dariaternovskaia.github.io/Umoral/content/philosophy/essays/reading-diary/le-fanu/" class="green-circle circle-2">
        Ле Фаню
      </a>
      
      <div class="green-circle circle-deco-1"></div>
      <div class="green-circle circle-deco-2"></div>
      <div class="green-circle circle-deco-3"></div>
    </div>
  </body>
</html>