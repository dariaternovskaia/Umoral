---
export const prerender = true;
---

<html>
  <head>
    <title>Читательский дневник | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/Umoral/bg-reading-diary.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        color: #fff;
        padding: 5rem 2rem 3rem;
        position: relative;
        overflow-x: hidden;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
        z-index: 100;
      }
      .nav a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
        transition: all 0.3s ease;
      }
      .nav a:hover {
        color: #fff;
        border-color: #fff;
        background: rgba(255,255,255,0.1);
      }

      h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.7);
        position: relative;
        z-index: 10;
      }

      .content {
        max-width: 900px;
        margin: 0 auto;
        position: relative;
        z-index: 10;
      }

      .video-section {
        margin-bottom: 3rem;
      }

      .video-container {
        width: 100%;
        position: relative;
        padding-bottom: 56.25%;
        height: 0;
        background: #000;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
      }

      .video-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        border: none;
      }

      .section-title {
        font-size: 1.8rem;
        margin-bottom: 1.5rem;
        text-align: center;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.7);
      }

      /* Контейнер для кружочков */
      .circles-container {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
      }

      .circle {
        position: absolute;
        border-radius: 50%;
        opacity: 0.4;
        transition: all 0.3s ease;
      }

      /* Кликабельные кружочки */
      .circle-link {
        pointer-events: auto;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: #fff;
        font-weight: 600;
        text-shadow: 0 1px 3px rgba(0,0,0,0.5);
        opacity: 0.85;
      }

      .circle-link:hover {
        opacity: 1;
        transform: scale(1.1);
        box-shadow: 0 0 30px rgba(46, 204, 113, 0.6);
      }

      /* Хаотичные декоративные кружочки разных оттенков зелёного */
      .circle:nth-child(1) { width: 120px; height: 120px; background: #2ecc71; top: 15%; left: 8%; }
      .circle:nth-child(2) { width: 80px; height: 80px; background: #27ae60; top: 28%; left: 85%; }
      .circle:nth-child(3) { width: 150px; height: 150px; background: #1abc9c; top: 68%; left: 12%; }
      .circle:nth-child(4) { width: 60px; height: 60px; background: #16a085; top: 75%; left: 72%; }
      .circle:nth-child(5) { width: 90px; height: 90px; background: #229954; top: 22%; left: 62%; }
      .circle:nth-child(6) { width: 110px; height: 110px; background: #1e8449; top: 85%; left: 35%; }
      .circle:nth-child(7) { width: 70px; height: 70px; background: #27ae60; top: 48%; left: 22%; }
      .circle:nth-child(8) { width: 130px; height: 130px; background: #1abc9c; top: 35%; left: 92%; }
      .circle:nth-child(9) { width: 100px; height: 100px; background: #2ecc71; top: 90%; left: 82%; }
      .circle:nth-child(10) { width: 85px; height: 85px; background: #229954; top: 70%; left: 58%; }
      .circle:nth-child(11) { width: 140px; height: 140px; background: #1e8449; top: 42%; left: 30%; }
      .circle:nth-child(12) { width: 95px; height: 95px; background: #27ae60; top: 80%; left: 15%; }
      .circle:nth-child(13) { width: 115px; height: 115px; background: #1abc9c; top: 18%; left: 75%; }
      .circle:nth-child(14) { width: 75px; height: 75px; background: #16a085; top: 55%; left: 88%; }
      .circle:nth-child(15) { width: 65px; height: 65px; background: #229954; top: 92%; left: 50%; }
      .circle:nth-child(16) { width: 105px; height: 105px; background: #58d68d; top: 45%; left: 5%; }
      .circle:nth-child(17) { width: 125px; height: 125px; background: #82e0aa; top: 30%; left: 48%; }

      /* Кликабельные кружочки-ссылки */
      .circle-link:nth-child(18) {
        width: 180px;
        height: 180px;
        background: #2ecc71;
        top: 50%;
        left: 70%;
        font-size: 1.1rem;
      }
      .circle-link:nth-child(19) {
        width: 160px;
        height: 160px;
        background: #27ae60;
        top: 55%;
        left: 25%;
        font-size: 1rem;
      }

      @media (max-width: 600px) {
        h1 { font-size: 1.8rem; }
        .section-title { font-size: 1.4rem; }
        .nav { top: 1rem; left: 1rem; flex-direction: column; gap: 0.5rem; }
        .circle-link:nth-child(18) { width: 140px; height: 140px; font-size: 0.9rem; }
        .circle-link:nth-child(19) { width: 120px; height: 120px; font-size: 0.85rem; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/content/philosophy/essays/">← Назад</a>
      <a href="/Umoral/">← На главную</a>
    </nav>

    <!-- Декоративные и кликабельные кружочки -->
    <div class="circles-container">
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <div class="circle"></div>
      <a href="/Umoral/content/philosophy/essays/reading-diary/krasznahorkai/" class="circle-link">Краснахоркаи</a>
      <a href="/Umoral/content/philosophy/essays/reading-diary/le-fanu/" class="circle-link">Ле Фаню</a>
    </div>

    <div class="content">
      <h1>Читательский дневник</h1>
      
      <div class="video-section">
        <h2 class="section-title">Экзистенциальная и притчевая реальность в романе Ласло Краснахоркаи "Сатанинское танго"</h2>
        <div class="video-container">
          <iframe 
            src="https://www.youtube.com/embed/NIwSpJbynUs"
            title="Читательский дневник"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowFullScreen
          ></iframe>
        </div>
      </div>
    </div>
  </body>
</html>