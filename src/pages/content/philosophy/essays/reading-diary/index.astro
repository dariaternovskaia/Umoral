---
export const prerender = true;
---

<html>
  <head>
    <title>Читательский дневник | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)), url('/Umoral/bg-reading-diary.jpg');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 100vh;
        color: #fff;
        padding: 5rem 2rem 3rem;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
      }
      .nav a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
      }
      .nav a:hover {
        color: #fff;
        border-color: #fff;
      }

      h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 3rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
      }

      .circles-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 2rem;
        padding: 1rem;
      }

      .circle {
        width: 220px;
        height: 220px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 1.5rem;
        font-size: 1.1rem;
        font-weight: bold;
        text-decoration: none;
        color: #fff;
        background: rgba(255, 255, 255, 0.1);
        border: 2px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(5px);
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        word-wrap: break-word;
        overflow-wrap: break-word;
      }

      .circle.clickable {
        cursor: pointer;
      }

      .circle.clickable:hover {
        background: rgba(255, 255, 255, 0.25);
        border-color: #fff;
        transform: scale(1.05);
        box-shadow: 0 0 25px rgba(255, 255, 255, 0.4);
      }

      .circle.non-clickable {
        cursor: default;
        opacity: 0.5;
        background: rgba(255, 255, 255, 0.05);
      }

      @media (max-width: 600px) {
        h1 { font-size: 1.8rem; }
        .circle {
          width: 180px;
          height: 180px;
          font-size: 1rem;
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/content/philosophy/essays/">← Назад</a>
      <a href="/Umoral/">← На главную</a>
    </nav>

    <div class="content">
      <h1>Читательский дневник</h1>
      
      <div class="circles-container">
        <!-- Кликабельный кружок 1: Краснахоркаи -->
        <a href="/Umoral/content/philosophy/essays/reading-diary/krasznahorkai/" class="circle clickable">
          Ласло Краснахоркаи<br>"Сатанинское танго"
        </a>

        <!-- Кликабельный кружок 2: Ле Фаню -->
        <a href="/Umoral/content/philosophy/essays/reading-diary/le-fanu/" class="circle clickable">
          Шеридан Ле Фаню<br>"Зелёный чай"
        </a>

        <!-- Неактивные кружки для будущего наполнения -->
        <div class="circle non-clickable">
          Скоро...
        </div>
        
        <div class="circle non-clickable">
          Скоро...
        </div>
      </div>
    </div>
  </body>
</html>