---
export const prerender = true;
---

<html>
  <head>
    <title>Работы для универа | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background: linear-gradient(135deg, #0f4c5c 0%, #208c8f 50%, #29a19c 100%);
        min-height: 100vh;
        color: #fff;
        padding: 5rem 2rem 3rem;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
      }
      .nav a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
      }
      .nav a:hover {
        color: #fff;
        border-color: #fff;
      }

      h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 4rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
      }

      .gallery-container {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        justify-content: center;
        gap: 4rem;
        flex-wrap: wrap;
      }

      .photo-frame {
        position: relative;
        width: 350px;
        height: 450px;
        text-decoration: none;
        transition: transform 0.3s;
      }

      .photo-frame:hover {
        transform: translateY(-10px) rotate(0deg) !important;
      }

      .string {
        position: absolute;
        top: -60px;
        left: 50%;
        width: 2px;
        height: 60px;
        background: linear-gradient(to bottom, rgba(255,255,255,0.6), rgba(255,255,255,0.2));
        transform: translateX(-50%);
        z-index: 1;
      }

      .clip {
        position: absolute;
        top: -8px;
        left: 50%;
        width: 20px;
        height: 25px;
        background: #8B4513;
        transform: translateX(-50%);
        border-radius: 2px;
        z-index: 2;
        box-shadow: 0 2px 5px rgba(0,0,0,0.3);
      }

      .clip::before {
        content: '';
        position: absolute;
        top: 5px;
        left: 50%;
        transform: translateX(-50%);
        width: 12px;
        height: 8px;
        background: #654321;
        border-radius: 1px;
      }

      .photo-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
        border: 8px solid #fff;
        border-bottom-width: 40px;
      }

      .photo-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .photo-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 2rem 1.5rem 1.5rem;
        background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
        color: #fff;
        text-align: center;
      }

      .photo-title {
        font-size: 1.3rem;
        font-weight: 300;
        margin-bottom: 0.5rem;
        letter-spacing: 1px;
        text-shadow: 0 2px 8px rgba(0,0,0,0.8);
      }

      .photo-year {
        font-size: 0.95rem;
        color: rgba(255,255,255,0.85);
        font-style: italic;
      }

      .photo-frame:nth-child(1) {
        transform: rotate(-2deg);
      }
      .photo-frame:nth-child(2) {
        transform: rotate(2deg);
      }

      @media (max-width: 800px) {
        .gallery-container {
          gap: 2rem;
        }
        .photo-frame {
          width: 280px;
          height: 360px;
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/content/philosophy/essays/">← Назад</a>
      <a href="/Umoral/">← На главную</a>
    </nav>

    <h1>Работы для универа</h1>

    <div class="gallery-container">
      <!-- Первое эссе -->
      <a href="/Umoral/content/philosophy/essays/university/sacred-scripture-senses/" class="photo-frame">
        <div class="string"></div>
        <div class="clip"></div>
        <div class="photo-wrapper">
          <img src="/Umoral/essays/essay1-sunset.jpg" alt="Смыслы Священного писания" />
          <div class="photo-overlay">
            <div class="photo-title">Смыслы Священного писания<br/>на материале Суммы теологии Фомы Аквинского</div>
            <div class="photo-year">2025</div>
          </div>
        </div>
      </a>

      <!-- Второе эссе -->
      <a href="/Umoral/content/philosophy/essays/university/comte-positivist-church/" class="photo-frame">
        <div class="string"></div>
        <div class="clip"></div>
        <div class="photo-wrapper">
          <img src="/Umoral/essays/essay2-cat.jpg" alt="Позитивистская церковь Конта" />
          <div class="photo-overlay">
            <div class="photo-title">Позитивистская церковь Конта<br/>как религия спасения</div>
            <div class="photo-year">2024</div>
          </div>
        </div>
      </a>
    </div>
  </body>
</html>