---
export const prerender = true;
---

<html>
  <head>
    <title>Работы для универа | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        background-color: #9a958a; /* Более тёмный тёплый фон */
        min-height: 100vh;
        color: #2c2b29;
        padding: 5rem 2rem 3rem;
        overflow-x: hidden;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
        z-index: 100;
      }
      .nav a {
        color: #5c4d3c;
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(92, 77, 60, 0.3);
        border-radius: 4px;
        transition: all 0.3s;
      }
      .nav a:hover {
        color: #2c2b29;
        border-color: #2c2b29;
        background: rgba(255,255,255,0.5);
      }

      h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 2rem;
        font-weight: 300;
        letter-spacing: 2px;
        color: #2c2b29;
        position: relative;
        z-index: 10;
      }

      .rope-container {
        position: relative;
        width: 100%;
        height: 600px;
        max-width: 1200px;
        margin: 0 auto;
      }

      .rope-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
        pointer-events: none;
      }

      .polaroid {
        position: absolute;
        background: #fff;
        padding: 15px 15px 50px 15px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        text-decoration: none;
        color: #2c2b29;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        z-index: 2;
        cursor: pointer;
      }

      .polaroid:hover {
        transform: scale(1.05) rotate(0deg) !important;
        box-shadow: 0 15px 35px rgba(0,0,0,0.3);
        z-index: 10;
      }

      .polaroid img {
        width: 280px;
        height: 350px;
        object-fit: cover;
        display: block;
        filter: sepia(10%);
      }

      .caption {
        text-align: center;
        margin-top: 15px;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        color: #4a4036;
        line-height: 1.4;
      }

      .clip {
        position: absolute;
        top: -15px;
        left: 50%;
        transform: translateX(-50%);
        width: 20px;
        height: 35px;
        background: #8b5a2b;
        border-radius: 4px;
        z-index: 3;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
      }
      
      .clip::after {
        content: '';
        position: absolute;
        top: 8px;
        left: 4px;
        width: 12px;
        height: 15px;
        background: #6d4621;
        border-radius: 2px;
      }

      .photo-1 {
        left: 15%;
        top: 180px;
        transform: rotate(-4deg);
      }

      .photo-2 {
        right: 15%;
        top: 220px;
        transform: rotate(3deg);
      }

      @media (max-width: 768px) {
        .rope-container { height: 800px; }
        .polaroid {
          position: relative;
          left: auto !important;
          right: auto !important;
          top: auto !important;
          margin: 2rem auto;
          transform: rotate(0deg) !important;
        }
        .rope-svg { display: none; }
        .clip { display: none; }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/content/philosophy/essays/">← Назад</a>
      <a href="/Umoral/">← На главную</a>
    </nav>

    <h1>Работы для универа</h1>

    <div class="rope-container">
      <svg class="rope-svg" viewBox="0 0 1000 300" preserveAspectRatio="none">
        <path d="M0,50 C300,150 700,50 1000,150" stroke="#4a4036" stroke-width="4" fill="none" stroke-linecap="round"/>
        <path d="M1000,150 C1020,140 1020,160 1000,150" stroke="#4a4036" stroke-width="4" fill="none"/>
      </svg>

      <a href="/Umoral/content/philosophy/essays/university/sacred-scripture-senses/" class="polaroid photo-1">
        <div class="clip"></div>
        <img src="/Umoral/essays/essay1-sunset.jpg" alt="Смыслы Священного писания" />
        <div class="caption">
          Смыслы Священного писания<br/>
          на материале «Суммы теологии»<br/>
          Фомы Аквинского<br/>
          <small>(2025)</small>
        </div>
      </a>

      <a href="/Umoral/content/philosophy/essays/university/comte-positivist-church/" class="polaroid photo-2">
        <div class="clip"></div>
        <img src="/Umoral/essays/essay2-cat.jpg" alt="Позитивистская церковь Конта" />
        <div class="caption">
          Позитивистская церковь Конта<br/>
          как религия спасения<br/>
          <small>(2024)</small>
        </div>
      </a>
    </div>
  </body>
</html>