---
export const prerender = true;
---

<html>
  <head>
    <title>Эссе и видео-эссе | Umoral</title>
    <meta charset="UTF-8">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Georgia', serif;
        /* Бирюзовый градиент */
        background: linear-gradient(135deg, #0f4c5c 0%, #208c8f 50%, #29a19c 100%);
        min-height: 100vh;
        color: #fff;
        padding: 5rem 2rem 3rem;
      }

      .nav {
        position: absolute;
        top: 2rem;
        left: 2rem;
        display: flex;
        gap: 1rem;
      }
      .nav a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
        font-size: 0.9rem;
        padding: 0.3rem 0.8rem;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
      }
      .nav a:hover {
        color: #fff;
        border-color: #fff;
      }

      h1 {
        text-align: center;
        font-size: 2.5rem;
        margin-bottom: 4rem;
        font-weight: 300;
        letter-spacing: 2px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.3);
      }

      .folders-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 3rem;
        max-width: 1000px;
        margin: 0 auto;
      }

      .folder-card {
        position: relative;
        height: 400px;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: #fff;
        box-shadow: 0 10px 40px rgba(0,0,0,0.4);
        transition: transform 0.3s, box-shadow 0.3s;
      }

      .folder-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      }

      .folder-bg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        transition: transform 0.3s;
      }

      .folder-card:hover .folder-bg {
        transform: scale(1.05);
      }

      .folder-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 3rem 2rem 2rem;
        background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
      }

      .folder-title {
        font-size: 2rem;
        font-weight: 600;
        text-shadow: 0 2px 10px rgba(0,0,0,0.5);
      }

      /* Первая карточка - Читательский дневник */
      .folder-card:nth-child(1) .folder-bg {
        background-image: url('/Umoral/bg-reading.jpg');
      }

      /* Вторая карточка - Работы для универа */
      .folder-card:nth-child(2) .folder-bg {
        background-image: url('/Umoral/bg-university.jpg');
      }

      @media (max-width: 700px) {
        .folders-container {
          grid-template-columns: 1fr;
        }
        .folder-card {
          height: 300px;
        }
      }
    </style>
  </head>
  <body>
    <nav class="nav">
      <a href="/Umoral/">← На главную</a>
      <a href="/Umoral/content/philosophy/thoughts/">← К мыслям</a>
    </nav>

    <h1>Эссе и видео-эссе</h1>

    <div class="folders-container">
      <a href="/Umoral/content/philosophy/essays/reading-diary/" class="folder-card">
        <div class="folder-bg"></div>
        <div class="folder-overlay">
          <div class="folder-title">Читательский дневник</div>
        </div>
      </a>

      <a href="/Umoral/content/philosophy/essays/university/" class="folder-card">
        <div class="folder-bg"></div>
        <div class="folder-overlay">
          <div class="folder-title">Работы для универа</div>
        </div>
      </a>
    </div>
  </body>
</html>